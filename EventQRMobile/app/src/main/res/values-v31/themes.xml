<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Starting theme for Android 12+ (API 31+).

        The system splash screen on API 31+ is drawn by the OS and its background
        (windowSplashScreenBackground) can only be a single opaque solid color - it does
        not support a gradient drawable (unlike android:windowBackground on older versions).
        We therefore keep the background as the gradient's dominant/center color
        (eventqr_indigo) and use a transparent animated icon so the native splash fades
        smoothly into the app's gradient+logo splash (activity_splash_modern.xml) without
        a jarring solid-color "flash". postSplashScreenTheme restores the normal app theme.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenBackground">@color/eventqr_indigo</item>
        <item name="postSplashScreenTheme">@style/Theme.EventQR</item>
    </style>

</resources>
