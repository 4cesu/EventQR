<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeletonLoading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp"
    android:visibility="gone">

    <!-- Section label placeholder -->
    <View
        android:layout_width="140dp"
        android:layout_height="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_staff_skeleton_bar" />

    <!-- Form card skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_staff_skeleton_card">

        <!-- Input field 1 placeholder (Full Name) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <!-- Input field 2 placeholder (Email) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <!-- Input field 3 placeholder (Phone) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>

    <!-- Security section label placeholder -->
    <View
        android:layout_width="80dp"
        android:layout_height="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_staff_skeleton_bar" />

    <!-- Change password card skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <View
            android:layout_width="130dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>

    <!-- Save button placeholder -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_staff_skeleton_bar" />
</LinearLayout>
