<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeletonLoading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_xl"
    android:visibility="gone">

    <!-- "Profile Information" section label placeholder -->
    <View
        android:layout_width="140dp"
        android:layout_height="12dp"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_skeleton_block" />

    <!-- Detail row 1 (Name) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="48dp"
            android:layout_height="12dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- Detail row 2 (Email) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="48dp"
            android:layout_height="12dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="160dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- Detail row 3 (Phone) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="48dp"
            android:layout_height="12dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="100dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- "Account" section label placeholder -->
    <View
        android:layout_width="80dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_skeleton_block" />

    <!-- Account item 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="100dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- Account item 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="150dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- Account item 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="130dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- Account item 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />
</LinearLayout>
