<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeletonLoading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <!-- "Profile Information" section label placeholder -->
    <View
        android:layout_width="120dp"
        android:layout_height="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_staff_skeleton_bar" />

    <!-- Profile details card skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_staff_skeleton_card">

        <!-- Name row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_staff_skeleton_date_block" />

            <View
                android:layout_width="80dp"
                android:layout_height="12dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_staff_skeleton_bar" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/outline" />

        <!-- Email row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_staff_skeleton_date_block" />

            <View
                android:layout_width="56dp"
                android:layout_height="12dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="160dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_staff_skeleton_bar" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/outline" />

        <!-- Phone row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_staff_skeleton_date_block" />

            <View
                android:layout_width="52dp"
                android:layout_height="12dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="100dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_staff_skeleton_bar" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Account" section label placeholder -->
    <View
        android:layout_width="80dp"
        android:layout_height="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_staff_skeleton_bar" />

    <!-- Menu card skeleton 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <View
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>

    <!-- Menu card skeleton 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <View
            android:layout_width="160dp"
            android:layout_height="14dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>

    <!-- Menu card skeleton 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <View
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>

    <!-- Menu card skeleton 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <View
            android:layout_width="130dp"
            android:layout_height="14dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>
</LinearLayout>
