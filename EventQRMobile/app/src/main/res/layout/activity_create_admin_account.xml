<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventqr_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_header_gradient"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/back_btn"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Super Admin Portal"
                android:textColor="#E6E9FF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Create Admin Account"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Use this page only to create administrator accounts for EventQR."
                android:textColor="#E0E7FF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_surface_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin Details"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="The new account will receive the Admin role only."
                    android:textColor="#6B7280"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="First Name"
                            android:textColor="#111827"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/inputAdminFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_auth_field"
                            android:hint="John"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/eventqr_text"
                            android:textColorHint="#71717A"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Name"
                            android:textColor="#111827"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/inputAdminLastName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_auth_field"
                            android:hint="Doe"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/eventqr_text"
                            android:textColorHint="#71717A"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Email Address"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/email_icon"
                    android:drawablePadding="10dp"
                    android:hint="johndoe@gmail.com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Phone Number"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/phone_icon"
                    android:drawablePadding="10dp"
                    android:hint="+63 912 345 6789"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Temporary Password"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="10dp"
                    android:hint="Enter password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/layoutPasswordRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_password_requirements"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewStrength1"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />

                        <View
                            android:id="@+id/viewStrength2"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />

                        <View
                            android:id="@+id/viewStrength3"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />

                        <View
                            android:id="@+id/viewStrength4"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtPasswordLengthRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="○ At least 8 characters"
                                android:textColor="@color/eventqr_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtPasswordCapitalRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="○ One uppercase letter"
                                android:textColor="@color/eventqr_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtPasswordNumberRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="○ One number"
                                android:textColor="@color/eventqr_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtPasswordSpecialRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="○ One special character"
                                android:textColor="@color/eventqr_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPasswordStrength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:textColor="@color/eventqr_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Confirm Password"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="10dp"
                    android:hint="Confirm password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnCreateAdminAccount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/eventqr_purple"
                    android:text="Create Admin Account"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
