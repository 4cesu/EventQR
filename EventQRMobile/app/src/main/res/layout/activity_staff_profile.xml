<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ==================== ACCENT MASTHEAD ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/accent_signal"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="@dimen/space_lg">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_profile_initial_avatar">

                        <TextView
                            android:id="@+id/txtProfileInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:fontFamily="@font/archivo_black"
                            android:textColor="@color/text_on_accent"
                            android:textSize="@dimen/type_display"
                            tools:text="J" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:fontFamily="@font/archivo_black"
                        android:textSize="@dimen/type_display"
                        android:textColor="@color/text_on_accent"
                        tools:text="Juan Dela Cruz" />

                    <TextView
                        android:id="@+id/txtProfileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="@font/jetbrains_mono_semibold"
                        android:textSize="@dimen/type_status"
                        android:textColor="@color/text_on_accent_muted"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        tools:text="ATTENDEE" />
                </LinearLayout>

                <!-- Error / Retry -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm">

                    <TextView
                        android:id="@+id/txtProfileError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/status_rejected"
                        android:textSize="@dimen/type_body_compact"
                        android:fontFamily="@font/archivo_regular"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnProfileRetry"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="Retry"
                        android:textAllCaps="false"
                        android:fontFamily="@font/archivo_semibold"
                        android:textColor="@color/accent_signal"
                        app:cornerRadius="@dimen/radius_sharp"
                        app:strokeColor="@color/accent_signal"
                        app:strokeWidth="1.5dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Skeleton loading -->
                <include layout="@layout/include_skeleton_profile" />

                <!-- Menu cards -->
                <LinearLayout
                    android:id="@+id/layoutProfileMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingTop="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_xl">

                    <Button
                        android:id="@+id/btnEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- ==================== SECTION 1: PROFILE INFORMATION ==================== -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="Profile Information"
                        android:textAppearance="@style/TextAppearance.EventQR.TextLabel"
                        android:textColor="@color/text_on_paper_muted" />

                    <!-- Name row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_person"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="NAME"
                            android:textAppearance="@style/TextAppearance.EventQR.TextLabel"
                            android:textColor="@color/text_on_paper_muted" />

                        <TextView
                            android:id="@+id/txtProfileDetailName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:fontFamily="@font/archivo_semibold"
                            android:textColor="@color/text_on_paper"
                            android:textSize="@dimen/type_body"
                            tools:text="Juan Dela Cruz" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <!-- Email row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_mail"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="EMAIL"
                            android:textAppearance="@style/TextAppearance.EventQR.TextLabel"
                            android:textColor="@color/text_on_paper_muted" />

                        <TextView
                            android:id="@+id/txtProfileDetailEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:fontFamily="@font/archivo_regular"
                            android:textColor="@color/text_on_paper"
                            android:textSize="@dimen/type_body"
                            tools:text="juan@example.com" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <!-- Phone row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_phone"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="PHONE"
                            android:textAppearance="@style/TextAppearance.EventQR.TextLabel"
                            android:textColor="@color/text_on_paper_muted" />

                        <TextView
                            android:id="@+id/txtProfileDetailPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:fontFamily="@font/jetbrains_mono_regular"
                            android:textColor="@color/text_on_paper"
                            android:textSize="@dimen/type_code"
                            tools:text="+639123456789" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <!-- ==================== SECTION 2: ACCOUNT ==================== -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="Account"
                        android:textAppearance="@style/TextAppearance.EventQR.TextLabel"
                        android:textColor="@color/text_on_paper_muted" />

                    <!-- Edit Profile -->
                    <LinearLayout
                        android:id="@+id/cardEditProfile"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_edit_pencil"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="Edit Profile"
                            android:textAppearance="@style/TextAppearance.EventQR.TextTitle"
                            android:textColor="@color/text_on_paper" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_on_paper_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <!-- Transaction History -->
                    <LinearLayout
                        android:id="@+id/cardTransactionHistory"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_history"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="Transaction History"
                            android:textAppearance="@style/TextAppearance.EventQR.TextTitle"
                            android:textColor="@color/text_on_paper" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_on_paper_muted" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerTransactionHistory"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <!-- Claimed Rewards -->
                    <LinearLayout
                        android:id="@+id/cardClaimedRewards"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nav_gift"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="Claimed Rewards"
                            android:textAppearance="@style/TextAppearance.EventQR.TextTitle"
                            android:textColor="@color/text_on_paper" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_on_paper_muted" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerClaimedRewards"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <!-- My Event Requests -->
                    <LinearLayout
                        android:id="@+id/cardMyEventRequests"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_event_request"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="My Event Requests"
                            android:textAppearance="@style/TextAppearance.EventQR.TextTitle"
                            android:textColor="@color/text_on_paper" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_on_paper_muted" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerMyEventRequests"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <!-- Sign Out -->
                    <LinearLayout
                        android:id="@+id/cardSignOut"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_logout"
                            app:tint="@color/text_on_paper" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:text="Sign Out"
                            android:textAppearance="@style/TextAppearance.EventQR.TextTitle"
                            android:textColor="@color/text_on_paper" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_on_paper_muted" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerSignOut"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavDashboard"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Dashboard"
                android:src="@drawable/ic_home"
                app:tint="@color/text_on_paper_muted" />

            <TextView
                android:id="@+id/txtNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/archivo_regular"
                android:text="Home"
                android:textColor="@color/text_on_paper_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navEvents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavEvents"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Events"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_on_paper_muted" />

            <TextView
                android:id="@+id/txtNavEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/archivo_regular"
                android:text="Events"
                android:textColor="@color/text_on_paper_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRegistered"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavRegistered"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Registered"
                android:src="@drawable/ic_nav_registered"
                app:tint="@color/text_on_paper_muted" />

            <TextView
                android:id="@+id/txtNavRegistered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/archivo_regular"
                android:text="Registered"
                android:textColor="@color/text_on_paper_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRewards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavRewards"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Rewards"
                android:src="@drawable/ic_nav_gift"
                app:tint="@color/text_on_paper_muted" />

            <TextView
                android:id="@+id/txtNavRewards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/archivo_regular"
                android:text="Rewards"
                android:textColor="@color/text_on_paper_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavProfile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/text_on_paper" />

            <TextView
                android:id="@+id/txtNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/archivo_semibold"
                android:text="Profile"
                android:textColor="@color/text_on_paper"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
