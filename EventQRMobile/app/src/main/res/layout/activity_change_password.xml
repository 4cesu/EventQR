<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventqr_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_back_chevron" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Change Password"
            android:textColor="@color/eventqr_text"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <ProgressBar
                android:id="@+id/progressChange"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Password"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_auth_field"
                android:drawableStart="@drawable/password_icon"
                android:drawableEnd="@drawable/ic_visibility_on"
                android:drawablePadding="10dp"
                android:hint="Enter current password"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/eventqr_text"
                android:textColorHint="#71717A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="New Password"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNewPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_auth_field"
                android:drawableStart="@drawable/password_icon"
                android:drawableEnd="@drawable/ic_visibility_on"
                android:drawablePadding="10dp"
                android:hint="Enter new password"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/eventqr_text"
                android:textColorHint="#71717A"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_password_requirements"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtPasswordLengthRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○ At least 8 characters"
                    android:textColor="@color/eventqr_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtPasswordCapitalRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="○ One uppercase letter"
                    android:textColor="@color/eventqr_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtPasswordNumberRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="○ One number"
                    android:textColor="@color/eventqr_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtPasswordSpecialRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="○ One special character"
                    android:textColor="@color/eventqr_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Confirm Password"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_auth_field"
                android:drawableStart="@drawable/password_icon"
                android:drawableEnd="@drawable/ic_visibility_on"
                android:drawablePadding="10dp"
                android:hint="Confirm new password"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/eventqr_text"
                android:textColorHint="#71717A"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:elevation="6dp"
                android:text="Change Password"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
